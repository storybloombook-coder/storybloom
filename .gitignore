# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

example

# iOS is not part of the Android-native product.
/ios

# Android is now the source of truth (Kotlin/Compose), not an Expo-generated
# folder. Build output and local machine settings remain ignored by
# android/.gitignore.

# Vosk models (~50-90MB each) — downloaded locally for the dev build, not
# committed. See app.json's react-native-vosk plugin config for the paths.
/assets/vosk-model-small-en-us
/assets/vosk-model-small-ru

# Local installable deliverables are handed off separately from source.
/Storybloom-*-release.apk
